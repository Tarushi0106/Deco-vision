# Copy this file to .env (which is gitignored) and fill in real values.

# Camera RTSP connection (seeds the initial "exit" camera row)
CAMERA_HOST=103.204.0.126
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=
CAMERA_STREAM_PATH=/h264/ch1/sub/av_stream

# Camera's onboard admin API (Allow List sync, SnapedFaces) - HTTPS port,
# often different from the RTSP port above
CAMERA_ADMIN_PORT=443

# Camera 2 (Main gate camera) and camera 3 (Technical section) - two RTSP
# channels off the same NVR unit, same login as camera 1 above. Leave
# CAMERA2_HOST/CAMERA3_HOST blank to skip seeding these rows.
CAMERA2_HOST=
CAMERA2_RTSP_PORT=554
CAMERA2_ADMIN_PORT=443

CAMERA3_HOST=
CAMERA3_RTSP_PORT=554
CAMERA3_ADMIN_PORT=443

# Force RTSP over TCP - most cameras/NVRs behind NAT never reply over UDP,
# which makes the stream silently fail to open with no useful error
RTSP_TRANSPORT=tcp

# Where this backend itself listens. 0.0.0.0 to allow LAN access (e.g. for
# colleagues on the same network); 127.0.0.1 to restrict to this machine only
SERVER_HOST=127.0.0.1
SERVER_PORT=8811
