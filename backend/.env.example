# Copy this file to .env (which is gitignored) and fill in real values.

# Camera RTSP connection (seeds the initial "exit" camera row)
CAMERA_HOST=103.204.0.126
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=
CAMERA_STREAM_PATH=/h264/ch1/sub/av_stream

# Camera's onboard admin API (Allow List sync, SnapedFaces) - HTTPS port,
# often different from the RTSP port above
CAMERA_ADMIN_PORT=443

# Camera 2 (Main gate camera) and camera 3 (Technical section) - two RTSP
# channels off the same NVR unit, same login as camera 1 above. Leave
# CAMERA2_HOST/CAMERA3_HOST blank to skip seeding these rows.
CAMERA2_HOST=
CAMERA2_RTSP_PORT=554
CAMERA2_ADMIN_PORT=443

CAMERA3_HOST=
CAMERA3_RTSP_PORT=554
CAMERA3_ADMIN_PORT=443

# Force RTSP over TCP - most cameras/NVRs behind NAT never reply over UDP,
# which makes the stream silently fail to open with no useful error
RTSP_TRANSPORT=tcp

# Where this backend itself listens. 0.0.0.0 to allow LAN access (e.g. for
# colleagues on the same network); 127.0.0.1 to restrict to this machine only
SERVER_HOST=127.0.0.1
SERVER_PORT=8811

# Unique footfall / people-counting (footfall_counter.py) is opt-in per
# camera - comma-separated list of camera IDs, cam_codes, or name substrings
# to run it on (e.g. "main_gate"). Empty disables footfall counting.
FOOTFALL_CAMERAS=
FOOTFALL_REID_WINDOW_MINUTES=10
FOOTFALL_SIMILARITY_THRESHOLD=0.30
FOOTFALL_REPORT_FINALIZE_TIME=00:05

# How long locally-recorded clips are kept before the daily prune job
# (scheduler.py) deletes them.
CLIP_RETENTION_DAYS=7
CLIP_RETENTION_PRUNE_TIME=00:15

# License & Camera Access Management (auth.py / license_db.py). JWT_SECRET
# is optional - if unset, a secret is generated once and persisted to
# backend/data/jwt_secret.key so restarts don't invalidate sessions; set it
# explicitly in production instead.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=60

# Bootstrap super-admin account for the License module, created on first
# run if no super_admin exists yet. Change the password after first login.
SUPER_ADMIN_EMAIL=admin@deco-vision.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Rate limit applied to the License module's login/activation endpoints.
AUTH_RATE_LIMIT=10/minute

# Desk-time analytics (desk_tracker.py): grace period before an unconfirmed
# desk goes from "present" to "away".
DESK_SESSION_GRACE_SECONDS=20

# --- Recognition pipeline tuning ----------------------------------------
# All optional - each has a default that reproduces exactly what this app
# already measured/shipped with. Only set one if you're deliberately
# retuning for a specific camera or deployment. See config.py for the full
# rationale behind each default.
RECOGNITION_SIMILARITY_THRESHOLD=0.30
RECOGNITION_DET_THRESH_DEFAULT=0.65
# Per-camera overrides as a JSON object, e.g. {"1": 0.5, "2": 0.45}
CAMERA_DET_THRESH_JSON=
CAMERA_DETECTION_MAX_DIM_JSON=
RECOGNITION_MAX_FULL_RES_RECHECKS=8
RECOGNITION_RECHECK_DET_THRESH=0.3
RECOGNITION_RECHECK_CROP_PADDING=0.8
# How many consecutive detection cycles the same name must appear before it's
# logged as an attendance/detection event (does not delay the live overlay)
RECOGNITION_MIN_CONSECUTIVE_HITS=1
DETECTION_LOG_COOLDOWN_SECONDS=30
DETECTION_EMBED_TIMEOUT_SECONDS=25
CAMERA_RECONNECT_BASE_DELAY_SECONDS=3
CAMERA_RECONNECT_MAX_DELAY_SECONDS=60
DETECTION_WORKER_MAX_CPU_CORES=4
DEFAULT_DETECTION_FPS=1
# DEBUG turns on per-frame recognition pipeline tracing (frame received ->
# sent to worker -> recognized -> stored) - noisy, meant for active debugging
LOG_LEVEL=INFO
