# Copy this file to .env (which is gitignored) and fill in real values.

# Camera RTSP connection (seeds the initial "exit" camera row)
CAMERA_HOST=103.204.0.126
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=
CAMERA_STREAM_PATH=/h264/ch1/sub/av_stream

# Camera's onboard admin API (Allow List sync, SnapedFaces) - HTTPS port,
# often different from the RTSP port above
CAMERA_ADMIN_PORT=443

# Force RTSP over TCP - most cameras/NVRs behind NAT never reply over UDP,
# which makes the stream silently fail to open with no useful error
RTSP_TRANSPORT=tcp

# Where this backend itself listens. 0.0.0.0 to allow LAN access (e.g. for
# colleagues on the same network); 127.0.0.1 to restrict to this machine only
SERVER_HOST=127.0.0.1
SERVER_PORT=8811

# Unique footfall (people counting) — opt-in per camera. Comma-separated
# entry/exit camera identifiers (numeric camera ID, cam_code, or a substring
# of the camera's name, e.g. "main_gate" for "Main gate camera"). Leave blank
# to disable footfall counting everywhere.
FOOTFALL_CAMERAS=main_gate

# How long, in minutes, a face embedding stays valid for re-identification
# before a re-appearance at the same camera counts as a new visit.
FOOTFALL_REID_WINDOW_MINUTES=10

# Cosine similarity floor for matching two embeddings as the same person —
# only used for a face with no recognized name (a recognized name always
# wins the match outright; see footfall_counter.py). 0.30 is a measured
# starting point, not a universal constant — re-tune per camera if needed.
FOOTFALL_SIMILARITY_THRESHOLD=0.30
