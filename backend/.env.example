# Backend Environment Configuration
# Copy this file to backend/.env and update with your values

# Backend Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8811

# Camera Configuration (Update these with your camera details)
CAMERA_HOST=192.168.1.100
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=your_camera_password
CAMERA_STREAM_PATH=/h264/ch1/sub/av_stream
CAMERA_ADMIN_PORT=443
RTSP_TRANSPORT=tcp

# Database Configuration (if using)
# DB_URL=postgresql://user:password@localhost/deco_vision

# AWS Configuration (if using S3 for clips storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# Logging
LOG_LEVEL=INFO

# Optional: API Keys for integrations
# SLACK_WEBHOOK_URL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
