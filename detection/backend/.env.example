# Copy to .env (gitignored) and adjust for the real deployment.

# Where the existing Parachute backend is reachable — this service is a
# CLIENT of Parachute's already-public API, never a direct code import.
PARACHUTE_API_BASE=http://127.0.0.1:8811
PARACHUTE_WS_BASE=ws://127.0.0.1:8811

# This service's own HTTP/WebSocket API.
DETECTION_SERVER_HOST=127.0.0.1
DETECTION_SERVER_PORT=8812

RECOGNITION_SIMILARITY_THRESHOLD=0.40
PERSON_DETECT_CONF=0.35
PERSON_DETECT_INTERVAL_SECONDS=1.0
FACE_DETECT_INTERVAL_SECONDS=1.0

FACE_TRAINING_MIN_NEW_SAMPLES=10
FACE_TRAINING_CHECK_INTERVAL_SECONDS=300
FACE_TRAINING_MAX_INTERVAL_SECONDS=21600
FACE_TRAINING_VALIDATION_CONFLICT_THRESHOLD=0.40

LOG_LEVEL=INFO
